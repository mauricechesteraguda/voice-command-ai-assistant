# Copy to .env and set host Pulse socket permissions; no secrets belong here.
HOST_UID=1000
HOST_GID=1000
UID=1000
GID=1000
AUDIO_GID=29
PULSE_SOCKET=/run/user/1000/pulse/native
PULSE_COOKIE=/run/user/1000/pulse/cookie
PULSE_SERVER=unix:/run/pulse/native
PULSE_SOURCE=default
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
